        /* Container for the boxes */
        .skills-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 10px;
        }

        /* The individual box style */
        .skill-box {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid #333;
            padding: 10px 20px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 0.9rem;
            color: #aaa;
            transition: all 0.3s ease;
            user-select: none;
            /* Prevents text highlighting */
            flex-grow: 1;
            text-align: center;
        }

        /* Hover effect */
        .skill-box:hover {
            border-color: var(--accent-cyan);
            background: rgba(0, 255, 242, 0.1);
            color: #fff;
            transform: translateY(-2px);
        }

        /* Selected State (Active) */
        .skill-box.selected {
            background: var(--accent-cyan);
            color: #000;
            border-color: var(--accent-cyan);
            font-weight: 700;
            box-shadow: 0 0 15px rgba(0, 255, 242, 0.4);
        }